---
const date = new Date('2026-09-19T19:00:00-05:00');
const mapEmbed = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3965.6042823129033!2d-75.5626607!3d6.315599300000001!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e442f1a00632491%3A0xdb4460f86a347c14!2sCl.%2026A%20%2357a-87%2C%20Quintas%20De%20La%20Cabanita%2C%20Bello%2C%20Antioquia!5e0!3m2!1ses-419!2sco!4v1788208675721!5m2!1ses-419!2sco';
const mapUrl = 'https://maps.app.goo.gl/YgAXpA8hNcoqAv7G9';
const message = encodeURIComponent('Hola, soy [Tu nombre]. Confirmo mi asistencia a los XV años de Lussiana.');
const phoneNumbers = ['573042467648'];
const photos = [
  { src: '/photos/1.jpg', alt: 'Foto 1' },
  { src: '/photos/2.jpg', alt: 'Foto 2' },
  { src: '/photos/3.jpg', alt: 'Foto 3' },
  { src: '/photos/4.jpg', alt: 'Foto 4' },
  { src: '/photos/5.jpg', alt: 'Foto 5' },
  { src: '/photos/6.jpg', alt: 'Foto 6' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#b87f8d" />
    <title>Mis XV · Lussiana</title>
  </head>
  <body>
    <main>
      <section class="cover">
        <div class="cover-art" aria-hidden="true"></div>
        <div class="cover-copy">
          <p class="eyebrow">Una noche para recordar</p>
          <p class="small-title">Mis</p>
          <h1>XV</h1>
          <p class="name">Lussiana</p>
          <p class="date">19 · 09 · 2026</p>
          <p class="cover-dedication" data-guest-dedication hidden></p>
          <a class="scroll-arrow" href="#historia" aria-label="Continuar a la invitación">↓</a>
        </div>
      </section>

      <section class="story section" id="historia">
        <p class="eyebrow">Una nueva etapa</p>

        <div class="invite">
          <p class="invite-family">La familia Ardila Loaiza</p>
          <p class="invite-names">Jorge y Leidy</p>
          <p class="invite-cta">te invitan a celebrar los XV años de</p>
          <p class="invite-hero">Lussiana</p>
        </div>

        <h2 class="story-heading">Hay momentos<br />que se quedan<br /><em>para siempre.</em></h2>

        <div class="copy invite-copy">
          <p class="letter-salutation" data-guest-salutation hidden></p>
          <p>15 años, un sueño que comienza y una noche que quedará para siempre en el corazón. Queremos compartir contigo la magia de este momento tan especial.</p>
          <p>Con mucha ilusión, quiero compartir contigo una noche que guardaré para siempre.</p>
          <p class="signature">Con cariño,<br /><strong>Lussiana</strong></p>
        </div>
      </section>

      <section class="event section">
        <p class="eyebrow">Guarda la fecha</p>
        <div class="event-card">
          <div><span class="label">Sábado</span><strong class="date-display"><b>19</b><span>septiembre<br /><small>2026</small></span></strong></div>
          <div><span class="label">Recepción</span><strong>7:00<br /><small>p. m.</small></strong></div>
        </div>
        <div class="countdown" data-countdown data-target={date.toISOString()}><div><b data-days>00</b><span>días</span></div><div><b data-hours>00</b><span>horas</span></div><div><b data-minutes>00</b><span>minutos</span></div><div><b data-seconds>00</b><span>segundos</span></div></div>
        <p class="punctual">Te esperamos con puntualidad para disfrutar desde el inicio de la fiesta y compartir más tiempo juntos.</p>
      </section>

      <section class="venue section">
        <div class="venue-photo"><iframe title="Ubicación de la recepción" src={mapEmbed} style="border:0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div>
        <div class="venue-copy">
          <p class="eyebrow">El lugar</p>
          <h2>Quintas De La Cabanita<br /><em>Recepción</em></h2>
          <address>Cl. 26A #57a-87<br />Bello, Antioquia</address>
          <a class="button" href={mapUrl} target="_blank" rel="noreferrer">Cómo llegar <span>↗</span></a>
        </div>
      </section>

      <section class="details section">
        <p class="eyebrow">Detalles de la noche</p>
        <h2 class="details-title">Todo pensado para<br /><em>celebrar juntos.</em></h2>
        <div class="detail-grid">
          <article><span class="detail-symbol">✦</span><h3>Código de<br /><em>vestimenta</em></h3><p><strong>No aplica</strong><br />Ven como te sientas cómodo y listo para celebrar.</p></article>
          <article><span class="detail-symbol">♡</span><h3>Mesa de<br /><em>regalos</em></h3><p>El detalle que elijas con cariño y nazca de tu corazón, será un recuerdo muy especial para Lussiana.</p></article>
        </div>
      </section>

      <section class="rsvp section">
        <p class="eyebrow">Confirma tu asistencia</p>
        <h2>¿Nos<br /><em>acompañas?</em></h2>
        <p>Por favor confirmar antes del <strong>12 de septiembre</strong>.</p>
        <p class="cupos-note" data-cupos-note hidden></p>
        <div class="actions">{phoneNumbers.map((phone) => <a class="button button-light rsvp-link" data-phone={phone} href={`https://wa.me/${phone}?text=${message}`} target="_blank" rel="noreferrer">Confirmar por WhatsApp ↗</a>)}</div>
      </section>

      <section class="gallery section">
        <p class="eyebrow">Recuerdos</p>
        <h2 class="gallery-heading">Momentos que<br /><em>nos unen.</em></h2>
        <div class="gallery-track">
          {photos.map((_, i) => (
            <div class="gallery-item is-placeholder" aria-hidden="true"
              data-symbol={['♡', '✦', '◇', '✿', '❋', '✧'][i]}>
              <span class="gallery-placeholder-text">Foto {i + 1}</span>
            </div>
          ))}
        </div>
        <p class="gallery-note">Galería próximamente — sube tus fotos a <code>public/photos/</code> para activarlas.</p>
        <div class="gallery-dots">
          {photos.map((_, i) => (
            <span class:list={['gallery-dot', { active: i === 0 }]} data-dot={i}></span>
          ))}
        </div>
      </section>

      <div class="lightbox" role="dialog" aria-label="Visor de fotos" hidden>
        <button class="lightbox-close" aria-label="Cerrar">&times;</button>
        <img class="lightbox-img" src="" alt="" />
      </div>

      <section class="photos section">
        <p class="eyebrow">La historia continúa</p>
        <div class="photos-grid"><div><h2>Comparte<br /><em>tus fotos.</em></h2><p>Guarda entre 3 y 6 fotos favoritas de la noche. Próximamente compartiremos la carpeta para reunir todos nuestros recuerdos.</p><button class="button is-disabled" type="button" disabled>Carpeta próximamente</button></div><div class="photo-frame" aria-hidden="true"><span>♡</span><small>Momentos para recordar</small></div></div>
      </section>

      <div class="music-card" aria-label="Control de música"><span class="music-note" aria-hidden="true">♫</span><div><p class="music-label">Música de fondo</p><strong>Angels</strong><small>Robbie Williams</small></div><button type="button" class="music-inline-btn" aria-pressed="false" aria-label="Reproducir música">▶</button></div>
      <footer><p class="hashtag">#Mis15Lussiana · #LUSSIANAXV</p><p>♪ Angel · Robbie Williams — Toca ♪ para reproducir</p><p class="footer-name">Lussiana · XV</p></footer>
    <audio id="bg-music" preload="metadata" loop src="/angels.mp3"></audio>
    </main>

    <script is:inline>
      const countdown = document.querySelector('[data-countdown]');
      const tick = () => { const diff = Math.max(0, new Date(countdown.dataset.target).getTime() - Date.now()); const values = [Math.floor(diff / 86400000), Math.floor(diff / 3600000) % 24, Math.floor(diff / 60000) % 60, Math.floor(diff / 1000) % 60]; ['days','hours','minutes','seconds'].forEach((key, i) => document.querySelector(`[data-${key}]`).textContent = String(values[i]).padStart(2, '0')); };
      tick(); setInterval(tick, 1000);
    </script>
    <script>
      const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
      const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
      const token = new URLSearchParams(window.location.search).get('invitacion');

      // "FLIA JARAMILLO RODRIGUEZ" → "Flia Jaramillo Rodriguez"
      // (partículas españolas quedan en minúscula: "María del Carmen Pérez")
      const TITLE_PARTICLES = new Set(['de', 'del', 'la', 'las', 'los', 'y', 'e', 'o', 'u', 'a', 'al']);
      const toTitleCase = (value: string): string =>
        value
          .trim()
          .toLowerCase()
          .split(/\s+/)
          .map((word, index) =>
            index > 0 && TITLE_PARTICLES.has(word)
              ? word
              : word.charAt(0).toUpperCase() + word.slice(1),
          )
          .join(' ');

      // "FLIA BIVANQUE RODRIGUEZ" → "Bivanque Rodriguez" (quita prefijo/sufijo familia)
      const cleanFamilyName = (rawName: string): string =>
        rawName
          .replace(/^(FLIA|FAMILIA)\s+/i, '')
          .replace(/\s+(Y\s+)?(FLIA|FAMILIA)\s*$/i, '')
          .trim();

      // a → Querida · d → Querido · fam → Querida familia X · grupo → Queridos
      // sin tratamiento: si el nombre parece familia (FLIA/FAMILIA) → familia, si no → Querida
      const buildSalutation = (
        displayName: string,
        rawName: string,
        treatment: string | null,
      ): string => {
        const looksLikeFamily = /^(FLIA|FAMILIA)\b|\bY\s+(FLIA|FAMILIA)\b/i.test(rawName);
        if (treatment === 'fam' || (!treatment && looksLikeFamily)) {
          return `Querida familia ${toTitleCase(cleanFamilyName(rawName))}:`;
        }
        if (treatment === 'd') return `Querido ${displayName}:`;
        if (treatment === 'grupo') return `Queridos ${displayName}:`;
        return `Querida ${displayName}:`;
      };

      const applyGuestPersonalization = async () => {
        if (!token || !supabaseUrl || !supabaseAnonKey) return;
        const dedication = document.querySelector<HTMLElement>('[data-guest-dedication]');
        const salutation = document.querySelector<HTMLElement>('[data-guest-salutation]');
        const cuposNote = document.querySelector<HTMLElement>('[data-cupos-note]');
        const rsvpLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.rsvp-link'));
        if (!dedication || !salutation || rsvpLinks.length === 0) return;
        try {
          const { createClient } = await import('@supabase/supabase-js');
          const supabase = createClient(supabaseUrl, supabaseAnonKey);
          const { data, error } = await supabase.rpc('get_guest_rsvp', { p_token: token });
          if (error || !Array.isArray(data) || data.length !== 1) return;
          const row = data[0];
          if (!row || row.slug !== 'lussiana-xv' || !row.guest_name) return;
          const rawName = String(row.guest_name);
          const displayName = toTitleCase(rawName);
          const treatment = typeof row.treatment === 'string' ? row.treatment : null;
          dedication.textContent = `para ${displayName}`;
          dedication.hidden = false;
          salutation.textContent = buildSalutation(displayName, rawName, treatment);
          salutation.hidden = false;
          // Cupos reservados (sección RSVP) — tuteo para individuales, ustedes para grupos
          if (cuposNote && typeof row.cupos === 'number' && row.cupos > 0) {
            const isGroup = treatment === 'fam' || treatment === 'grupo';
            const noun = row.cupos === 1 ? 'cupo' : 'cupos';
            cuposNote.textContent = isGroup
              ? `Reservamos ${row.cupos} ${noun} para ustedes`
              : `Reservamos ${row.cupos} ${noun} para ti`;
            cuposNote.hidden = false;
          }
          const encodedName = encodeURIComponent(displayName);
          rsvpLinks.forEach((link) => {
            link.href = link.href.replace('%5BTu%20nombre%5D', encodedName);
          });
        } catch {
          return;
        }
      };

      applyGuestPersonalization();
    </script>
    <script is:inline>
      const lightbox = document.querySelector('.lightbox');
      const lightboxImg = document.querySelector('.lightbox-img');
      const closeLightbox = () => { lightbox.hidden = true; lightbox.classList.remove('active'); };
      document.querySelectorAll('.gallery-item').forEach(item => {
        if (item.classList.contains('is-placeholder')) return;
        item.addEventListener('click', () => {
          const img = item.querySelector('img');
          if (!img) return;
          lightboxImg.src = img.src; lightboxImg.alt = img.alt;
          lightbox.hidden = false; lightbox.classList.add('active');
        });
        item.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); item.click(); } });
      });
      document.querySelector('.lightbox-close').addEventListener('click', closeLightbox);
      lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !lightbox.hidden) closeLightbox(); });
      const galleryObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add('visible'); galleryObserver.unobserve(entry.target); } });
      }, { threshold: 0.15 });
      document.querySelectorAll('.gallery-item').forEach((item, i) => { item.style.setProperty('--d', `${i * .08}s`); galleryObserver.observe(item); });
      // Carousel dots
      const track = document.querySelector('.gallery-track');
      const dots = document.querySelectorAll('.gallery-dot');
      const items = document.querySelectorAll('.gallery-item');
      const updateDots = () => {
        const scrollLeft = track.scrollLeft;
        const trackWidth = track.scrollWidth - track.clientWidth;
        const progress = trackWidth > 0 ? scrollLeft / trackWidth : 0;
        const active = Math.round(progress * (items.length - 1));
        dots.forEach((d, i) => d.classList.toggle('active', i === active));
      };
      track.addEventListener('scroll', updateDots, { passive: true });
      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          items[i].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        });
      });
    </script>

    <button class="music-fab" type="button" aria-pressed="false" aria-label="Reproducir música"><span class="music-fab-icon" aria-hidden="true">♪</span><span class="music-fab-label">Música</span></button>
    <script is:inline>
      (() => {
        const fab = document.querySelector('.music-fab');
        const fabIcon = fab?.querySelector('.music-fab-icon');
        const fabLabel = fab?.querySelector('.music-fab-label');
        const inlineBtn = document.querySelector('.music-inline-btn');
        const audio = document.getElementById('bg-music');
        const setState = (playing) => {
          fab?.setAttribute('aria-pressed', String(playing));
          fab?.setAttribute('aria-label', playing ? 'Pausar música' : 'Reproducir música');
          fab?.classList.toggle('is-playing', playing);
          if (fabIcon) fabIcon.textContent = playing ? '❚❚' : '♪';
          if (fabLabel) fabLabel.textContent = playing ? 'Pausar' : 'Música';
          if (inlineBtn) {
            inlineBtn.setAttribute('aria-pressed', String(playing));
            inlineBtn.setAttribute('aria-label', playing ? 'Pausar música' : 'Reproducir música');
            inlineBtn.textContent = playing ? '❚❚' : '▶';
            inlineBtn.classList.toggle('is-playing', playing);
          }
        };
        const toggle = async () => {
          const isPlaying = fab?.classList.contains('is-playing');
          if (!isPlaying && audio && audio.getAttribute('src')) {
            try { await audio.play(); setState(true); } catch { setState(false); }
          } else if (isPlaying && audio && !audio.paused) {
            audio.pause(); setState(false);
          } else {
            setState(!isPlaying);
          }
        };
        fab?.addEventListener('click', toggle);
        inlineBtn?.addEventListener('click', toggle);
        if (audio) {
          audio.addEventListener('ended', () => setState(false));
          audio.addEventListener('pause', () => { if (!audio.ended) setState(false); });
        }
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          // respeta reduce-motion: no animación extra, pero control funcional sigue
        }
      })();
    </script>
  </body>
</html>

<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=Parisienne&family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&display=swap');
:root{--rose-pale:#f7e4ea;--rose-dusty:#d9a4b0;--rose-malva:#b87f8d;--champagne:#e5c39a;--ivory:#f5eee9;--ink:#4a2d3a;--rose:#b87f8d;--blush:#f7e4ea;--cream:#f5eee9;--gold:#e5c39a;--gold-deep:#d9a4b0;--serif:'Playfair Display',Georgia,serif;--sans:'DM Sans',sans-serif}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font:17px/1.65 var(--sans)}main{overflow:hidden}.cover{min-height:100svh;position:relative;display:grid;place-items:end center;padding-bottom:7vh;text-align:center;color:#f5eee9;background:#b87f8d}.cover-art,.venue-photo{position:absolute;inset:0;background:linear-gradient(135deg,#b87f8d 0%,#d9a4b0 60%)}.cover-art{filter:saturate(.9) brightness(1.02);opacity:.42}.cover:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(184,127,141,.22),rgba(184,127,141,.38))}.cover-copy{position:relative;z-index:1;width:min(92%,650px)}.eyebrow,.label{letter-spacing:.18em;text-transform:uppercase;font-size:.7rem}.cover .eyebrow{color:#f5eee9}.small-title{font:italic 1.6rem var(--serif);margin:4rem 0 0}.cover h1{font:clamp(10rem,35vw,19rem)/.8 var(--serif);font-weight:400;letter-spacing:-.08em;margin:.4rem 0;background:linear-gradient(110deg,#f5eee9 12%,#e5c39a 35%,#f5eee9 48%,#d9a4b0 62%,#f7e4ea 80%);background-size:220% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;text-shadow:none;animation:xv-shine 4.5s ease-in-out infinite}@keyframes xv-shine{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}.name{font:italic clamp(4.5rem,16vw,10rem)/.85 'Parisienne',cursive;letter-spacing:.01em;text-transform:none;margin:3.5rem 0 1.15rem;color:#f5eee9;text-shadow:0 2px 18px rgba(74,45,58,.6)}.date{margin-top:1.6rem;letter-spacing:.2em;color:#f5eee9}.scroll-arrow{display:inline-block;margin-top:5rem;color:#e5c39a;text-decoration:none;font:2rem/1 var(--serif);animation:float-arrow 2s ease-in-out infinite}.scroll-arrow:focus-visible{outline:1px solid #f5